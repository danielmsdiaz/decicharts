VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Somente servidor. Nunca use prefixo VITE_ para a conexão do banco.
DATABASE_URL=
# Opcional: conexão direta para Prisma Migrate. Em Neon, o host direto é
# derivado automaticamente de DATABASE_URL quando esta variável está vazia.
DATABASE_URL_UNPOOLED=
# Opcional: usa VITE_FIREBASE_PROJECT_ID quando vazio.
FIREBASE_PROJECT_ID=
