generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["decicharts"]
}

model Profile {
  uid       String     @id(map: "profiles_pkey")
  name      String?
  email     String?
  photoUrl  String?    @map("photo_url")
  timezone  String     @default("America/Recife")
  unit      String     @default("dB")
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  analyses  Analysis[]
  imports   MeasurementImport[]

  @@map("profiles")
  @@schema("decicharts")
}

model Analysis {
  userUid     String          @map("user_uid")
  id          String          @db.Uuid
  name        String
  state       String          @default("uploading")
  metadata    Json            @db.JsonB
  chart       Json            @db.JsonB
  recordCount Int             @map("record_count")
  chunkCount  Int             @map("chunk_count")
  importId    String          @map("import_id") @db.Uuid
  ordinal     Int
  firstTs     BigInt?         @map("first_ts")
  lastTs      BigInt?         @map("last_ts")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  profile     Profile         @relation(fields: [userUid], references: [uid], onDelete: Cascade, onUpdate: NoAction, map: "analyses_user_uid_fkey")
  chunks      AnalysisChunk[]
  import      MeasurementImport @relation(fields: [userUid, importId], references: [userUid, id], onDelete: Cascade, onUpdate: NoAction)
  snapshots   ImportSavePoint[]

  @@id([userUid, id], map: "analyses_pkey")
  @@index([userUid, updatedAt(sort: Desc), id], map: "analyses_owner_updated")
  @@unique([userUid, importId, ordinal])
  @@unique([userUid, importId, id])
  @@map("analyses")
  @@schema("decicharts")
}

model MeasurementImport {
  userUid      String @map("user_uid")
  id           String @db.Uuid
  name         String
  fileName     String @map("file_name")
  sheetName    String @map("sheet_name")
  pointCount   Int @map("point_count")
  recordCount  Int @map("record_count")
  state        String @default("uploading")
  version      Int @default(0)
  activeSaveId String? @map("active_save_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  profile      Profile @relation(fields: [userUid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  points       Analysis[]
  saves        ImportSave[] @relation("ImportSaves")
  activeSave   ImportSave? @relation("PublishedSave", fields: [userUid, id, activeSaveId], references: [userUid, importId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userUid, id])
  @@index([userUid, updatedAt(sort: Desc), id])
  @@map("measurement_imports")
  @@schema("decicharts")
}

model ImportSave {
  userUid     String @map("user_uid")
  importId    String @map("import_id") @db.Uuid
  id          String @db.Uuid
  name        String
  baseVersion Int @map("base_version")
  state       String @default("uploading")
  version     Int?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  import      MeasurementImport @relation("ImportSaves", fields: [userUid, importId], references: [userUid, id], onDelete: Cascade, onUpdate: NoAction)
  publishedBy MeasurementImport[] @relation("PublishedSave")
  points      ImportSavePoint[]

  @@id([userUid, importId, id])
  @@index([userUid, updatedAt])
  @@map("import_saves")
  @@schema("decicharts")
}

model ImportSavePoint {
  userUid  String @map("user_uid")
  importId String @map("import_id") @db.Uuid
  saveId   String @map("save_id") @db.Uuid
  pointId  String @map("point_id") @db.Uuid
  ordinal  Int
  chart    Json @db.JsonB
  save     ImportSave @relation(fields: [userUid, importId, saveId], references: [userUid, importId, id], onDelete: Cascade, onUpdate: NoAction)
  point    Analysis @relation(fields: [userUid, importId, pointId], references: [userUid, importId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userUid, importId, saveId, pointId])
  @@unique([userUid, importId, saveId, ordinal])
  @@map("import_save_points")
  @@schema("decicharts")
}

model AnalysisChunk {
  userUid        String   @map("user_uid")
  analysisId     String   @map("analysis_id") @db.Uuid
  chunkIndex     Int      @map("chunk_index")
  recordCount    Int      @map("record_count")
  firstTs        BigInt   @map("first_ts")
  lastTs         BigInt   @map("last_ts")
  duplicateCount Int      @map("duplicate_count")
  payload        Json     @db.JsonB
  analysis       Analysis @relation(fields: [userUid, analysisId], references: [userUid, id], onDelete: Cascade, onUpdate: NoAction, map: "analysis_chunks_user_uid_analysis_id_fkey")

  @@id([userUid, analysisId, chunkIndex], map: "analysis_chunks_pkey")
  @@map("analysis_chunks")
  @@schema("decicharts")
}

// Preserved as a historical record of the pre-Prisma migration. Prisma Migrate
// owns all new migration tracking through its own _prisma_migrations table.
model LegacyMigration {
  version   String   @id(map: "schema_migrations_pkey")
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
  @@schema("decicharts")
}
