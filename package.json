{
  "name": "decicharts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run db:generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run db:generate && tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "test:neon": "RUN_NEON_INTEGRATION=1 vitest run tests/neon.integration.test.ts",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate:dev": "node scripts/prisma.mjs migrate dev",
    "db:baseline": "node --experimental-strip-types scripts/prisma-baseline.mjs",
    "db:status": "node scripts/prisma.mjs migrate status",
    "db:studio": "node scripts/prisma.mjs studio",
    "postinstall": "npm run db:generate",
    "db:check": "node scripts/prisma.mjs migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "firebase": "^12.6.0",
    "jose": "^6.2.18",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.6",
    "tailwind-merge": "^3.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "effect": "^3.22.5"
  }
}
