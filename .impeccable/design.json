      "html": "<button class=\"ds-button-primary\">Salvar análise</button>",
      "css": ".ds-button-primary{font-family:\"DM Sans Variable\",sans-serif;font-size:14px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:8px 16px;border-radius:8px;cursor:pointer;transition:color 150ms,background-color 150ms,border-color 150ms;border:0;background:var(--primary,#116b5c);color:var(--primary-foreground,#fff);}.ds-button-primary:hover{background:color-mix(in srgb,var(--primary,#116b5c) 90%,transparent);}.ds-button-primary:focus-visible{outline:2px solid var(--ring,#0b7566);outline-offset:2px;}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
